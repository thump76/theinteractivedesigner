---
import '../styles/global.css';

const {
  title,
  description = 'Notes on interactive design, interfaces, and the craft of building them.',
  image,
  type = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E30613" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title="The Interactive Designer" href="/rss.xml" />
    {/* No webfonts. Helvetica is already on the device, or Arial is. */}
  </head>

  <body>
    <div class="shell">
      <header class="masthead">
        <a class="wordmark" href="/">The Interactive <mark>Designer</mark></a>
        <nav>
          <a href="/">Archive</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
    </div>

    <div class="band" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="shell">
      <main>
        <slot />
      </main>

      <footer class="foot">
        <span>&copy; {year} The Interactive Designer</span>
        <a href="/rss.xml">Subscribe</a>
      </footer>
    </div>
  </body>
</html>
