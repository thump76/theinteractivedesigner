---
import '../styles/global.css';
import '../styles/pages.css';
import PersonSchema from '../components/PersonSchema.astro';

const {
  title,
  description = 'Notes on interactive design, interfaces, and the craft of building them.',
  image,
  type = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E30613" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="alternate" type="application/rss+xml" title="The Interactive Designer" href="/rss.xml" />
    {/* No webfonts. Helvetica is already on the device, or Arial is. */}
    <PersonSchema />
  </head>

  <body>
    <div class="shell">
      <header class="masthead">
        <a class="wordmark" href="/">The Interactive <mark>Designer</mark></a>
        <nav>
          <a href="/">Archive</a>
          <a href="/apps/">Apps</a>
          <a href="/cv/">CV</a>
          <a href="/contact/">Contact</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
    </div>

    <div class="band" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="shell">
      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <nav aria-label="Other sites by Philip Brumpton">
          <p>Also by me</p>
          <ul>
            <li><a href="https://vendum.coffee" rel="me noopener">VENDUM Coffee</a></li>
            <li><a href="https://getkeycut.com" rel="me noopener">KeyCut</a></li>
            <li><a href="https://whoismymp.uk" rel="me noopener">Who Is My MP?</a></li>
            <li><a href="https://thelords.app" rel="me noopener">The Lords</a></li>
            <li><a href="https://bikesand.co" rel="me noopener">Bikes&amp;.co</a></li>
            <li><a href="https://thenegativescanner.co.uk" rel="me noopener">The Negative Scanner</a></li>
            <li><a href="https://p100.uk" rel="me noopener">P100</a></li>
          </ul>
        </nav>
        <p class="colophon">
          <span>&copy; {year} The Interactive Designer. Philip Brumpton.</span>
          <a href="/rss.xml">Subscribe</a>
          <a href="https://www.linkedin.com/in/philipbrumpton" rel="me noopener">LinkedIn</a>
        </p>
      </footer>
    </div>
  </body>
</html>
