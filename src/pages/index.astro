---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const total = posts.length;
const HUES = ['red', 'blue', 'yellow'];

// Swiss date: 22.07.2026
const fmt = (d) =>
  [d.getDate(), d.getMonth() + 1].map((n) => String(n).padStart(2, '0')).join('.') +
  '.' + d.getFullYear();
---

<Base title="The Interactive Designer">
  <section class="hero grid">
    <h1 class="hero__title">Notes on <em>interactive</em> design</h1>
    <p class="hero__note">Written by a designer who still writes the CSS. Interfaces, typography, and the gap between a design and the thing that ships.</p>
  </section>

  <section class="archive">
    {posts.map((post, i) => {
      const number = total - i;
      return (
        <article class="entry grid">
          <div class="entry__marker" data-hue={HUES[(number - 1) % 3]}>
            {String(number).padStart(2, '0')}
          </div>
          <div class="entry__body">
            <p class="entry__date">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </p>
            <h2 class="entry__title">
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </h2>
            {post.data.standfirst && <p class="entry__standfirst">{post.data.standfirst}</p>}
          </div>
          {post.data.image && (
            <img
              class="entry__thumb"
              src={post.data.image}
              alt={post.data.imageAlt ?? ''}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
        </article>
      );
    })}
  </section>
</Base>
