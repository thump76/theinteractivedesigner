---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const HUES = ['red', 'blue', 'yellow'];

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, number: i + 1 },
  }));
}

const { post, number } = Astro.props;
const { Content } = await render(post);

const d = post.data.date;
const fmt =
  [d.getDate(), d.getMonth() + 1].map((n) => String(n).padStart(2, '0')).join('.') +
  '.' + d.getFullYear();

const site = 'https://theinteractivedesigner.co.uk';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Article schema. The author @id is the same node PersonSchema defines
// in the layout head, so every post resolves to one person rather than
// a fresh Philip Brumpton each time.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.standfirst,
  datePublished: d.toISOString(),
  dateModified: (post.data.updated ?? d).toISOString(),
  inLanguage: 'en-GB',
  mainEntityOfPage: canonical,
  url: canonical,
  author: { '@id': `${site}/#philip` },
  publisher: { '@id': `${site}/#svpply` },
  isPartOf: { '@id': `${site}/#website` },
  ...(post.data.image
    ? { image: new URL(post.data.image, Astro.site).href }
    : {}),
};
---

<Base
  title={`${post.data.title} — The Interactive Designer`}
  description={post.data.standfirst}
  image={post.data.image}
  type="article"
  published={d.toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <article class="post">
    <a class="back" href="/">← Archive</a>

    <header class="post__head grid">
      <h1 class="post__title">{post.data.title}</h1>
      <div class="post__aside">
        <span class="post__number" data-hue={HUES[(number - 1) % 3]}>
          {String(number).padStart(2, '0')}
        </span>
        <p class="label"><time datetime={d.toISOString()}>{fmt}</time></p>
        <p class="byline">
          <a href="/cv/" rel="author">Philip Brumpton</a>
        </p>
      </div>
      {post.data.standfirst && <p class="post__standfirst">{post.data.standfirst}</p>}
    </header>

    {post.data.image && (
      <figure class="post__figure">
        <img src={post.data.image} alt={post.data.imageAlt ?? ''} />
      </figure>
    )}

    <div class="grid">
      <div class="prose">
        <Content />
      </div>

      {post.data.link && (
        <div class="source">
          <p class="label">{post.data.linkLabel ?? 'Related'}</p>
          <a href={post.data.link}>{post.data.link}</a>
        </div>
      )}
    </div>

    <aside class="post__author">
      <img
        class="post__author-photo"
        src="/images/philip-brumpton-400.jpg"
        width="400"
        height="400"
        alt=""
        loading="lazy"
      />
      <p>
        Written by <a href="/cv/" rel="author">Philip Brumpton</a>, a product designer
        in South East London who still writes the CSS. He runs{' '}<a
          href="https://vendum.coffee">VENDUM Coffee</a> and builds his own{' '}<a
          href="/apps/">iPhone apps</a>.
      </p>
    </aside>
  </article>
</Base>
